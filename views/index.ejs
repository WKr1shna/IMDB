<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle || 'Wysteria' %></title>
  <link rel="preconnect" href="https://cdn.jsdelivr.net">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link rel="icon" type="image/png" href="/favicon.png">
  <link rel="apple-touch-icon" href="/favicon.png">
  <link href="/styles.css" rel="stylesheet">
</head>
<body>
  <%- include('./navbar.ejs') %>

  <% const carouselMovies = currentPath === '/' && !searchQuery ? allMovies.filter(movie => movie.backdrop_path || movie.poster_path).slice(0, 5) : []; %>
  <% const surpriseMovies = currentPath === '/' && !searchQuery && typeof randomMovies !== 'undefined' ? randomMovies : []; %>

  <main class="page-shell">
    <div class="container">
      <% if (carouselMovies.length > 0) { %>
        <section class="home-carousel" aria-label="Featured movies">
          <div id="homeMovieCarousel" class="carousel slide" data-bs-ride="carousel">
            <div class="carousel-indicators">
              <% carouselMovies.forEach((movie, index) => { %>
                <button
                  type="button"
                  data-bs-target="#homeMovieCarousel"
                  data-bs-slide-to="<%= index %>"
                  class="<%= index === 0 ? 'active' : '' %>"
                  aria-current="<%= index === 0 ? 'true' : 'false' %>"
                  aria-label="Slide <%= index + 1 %>"
                ></button>
              <% }) %>
            </div>

            <div class="carousel-inner">
              <% carouselMovies.forEach((movie, index) => { %>
                <% const backdrop = movie.backdrop_path || movie.poster_path; %>
                <div class="carousel-item <%= index === 0 ? 'active' : '' %>">
                  <div
                    class="featured-slide"
                    style="background-image: url('https://image.tmdb.org/t/p/w1280<%= backdrop %>');"
                  >
                    <div class="featured-slide-content">
                      <% if (movie.poster_path) { %>
                        <img
                          src="https://image.tmdb.org/t/p/w342<%= movie.poster_path %>"
                          alt="<%= movie.title %> poster"
                          class="featured-poster"
                          width="150"
                          height="225"
                          decoding="async"
                          <%= index === 0 ? 'fetchpriority="high"' : 'loading="lazy"' %>
                        >
                      <% } %>

                      <div class="featured-copy">
                        <div class="eyebrow">Featured Now</div>
                        <h2><%= movie.title %></h2>
                        <p>
                          <%= movie.overview ? movie.overview.slice(0, 180) + (movie.overview.length > 180 ? '...' : '') : 'Discover ratings, reviews, and details for this movie.' %>
                        </p>
                        <div class="featured-meta">
                          <span>
                            <i class="bi bi-calendar3"></i>
                            <%= movie.release_date ? movie.release_date.split('-')[0] : 'N/A' %>
                          </span>
                          <span>
                            <i class="bi bi-star-fill"></i>
                            <%= movie.vote_average ? movie.vote_average.toFixed(1) : '0.0' %>
                          </span>
                        </div>
                        <a href="/movie/<%= movie.id %>" class="btn btn-primary">
                          <i class="bi bi-eye me-1"></i> View Details
                        </a>
                      </div>
                    </div>
                  </div>
                </div>
              <% }) %>
            </div>

            <button class="carousel-control-prev" type="button" data-bs-target="#homeMovieCarousel" data-bs-slide="prev" aria-label="Previous movie">
              <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            </button>
            <button class="carousel-control-next" type="button" data-bs-target="#homeMovieCarousel" data-bs-slide="next" aria-label="Next movie">
              <span class="carousel-control-next-icon" aria-hidden="true"></span>
            </button>
          </div>
        </section>
      <% } %>

      <% if (surpriseMovies.length > 0) { %>
        <section class="random-movies-section" aria-label="Random movie recommendations">
          <div class="section-header compact-section-header">
            <div>
              <div class="eyebrow">Fresh Mix</div>
              <h1 class="random-section-title">Surprise Picks</h1>
              <p class="page-subtitle">A rotating set of well-loved movies from different corners of the library.</p>
            </div>
          </div>

          <div class="random-movie-grid">
            <% for (let movie of surpriseMovies) { %>
              <article class="movie-card random-movie-card">
                <div class="poster-frame">
                  <% if (movie.poster_path) { %>
                    <img
                      src="https://image.tmdb.org/t/p/w342<%= movie.poster_path %>"
                      class="movie-img"
                      alt="<%= movie.title %> poster"
                      loading="lazy"
                      decoding="async"
                    >
                  <% } else { %>
                    <div class="poster-placeholder">
                      <i class="bi bi-film"></i>
                    </div>
                  <% } %>
                </div>
                <div class="movie-card-body">
                  <div class="d-flex justify-content-between align-items-start gap-3">
                    <div>
                      <h2 class="movie-title">
                        <%= movie.title %>
                      </h2>
                      <div class="movie-meta">
                        <%= movie.release_date ? movie.release_date.split('-')[0] : 'N/A' %>
                      </div>
                    </div>
                    <span class="rating-pill">
                      <i class="bi bi-star-fill"></i>
                      <%= movie.avgRating ? movie.avgRating.toFixed(1) : '0.0' %>
                    </span>
                  </div>
                  <a href="/movie/<%= movie.id %>" class="btn btn-primary mt-auto">
                    <i class="bi bi-eye me-1"></i> View Details
                  </a>
                </div>
              </article>
            <% } %>
          </div>
        </section>
      <% } %>

      <%
        const movieGenres = {
          '28': 'Action',
          '12': 'Adventure',
          '16': 'Animation',
          '35': 'Comedy',
          '80': 'Crime',
          '99': 'Documentary',
          '18': 'Drama',
          '10751': 'Family',
          '14': 'Fantasy',
          '36': 'History',
          '27': 'Horror',
          '9648': 'Mystery',
          '10749': 'Romance',
          '878': 'Sci-Fi',
          '53': 'Thriller',
          '37': 'Western'
        };
        const genreMap = movieGenres;
        const activeGenreLabel = selectedGenre ? genreMap[selectedGenre] : '';
        const sortLabels = {
          'popularity.desc': 'Most Popular',
          'vote_average.desc': 'Highest Rated',
          'release_date.desc': 'Latest Release'
        };
        const activeSortLabel = selectedSort ? (sortLabels[selectedSort] || 'Popularity') : 'Popularity';
        const activeFilterCount = (selectedGenre ? 1 : 0) + (selectedYear ? 1 : 0) + (selectedSort && selectedSort !== 'popularity.desc' ? 1 : 0);
      %>

      <section class="section-header">
        <div>
          <div class="eyebrow">Wysteria Library</div>
          <h1 class="page-title"><%= pageTitle || 'Browse Movies' %></h1>
          <p class="page-subtitle"><%= pageSubtitle || 'Rate films, read quick reactions, and find your next watch.' %></p>
        </div>
      </section>

      <!-- Compact Modern Filter Toolbar -->
      <div class="browse-toolbar-wrapper">
        <div class="browse-toolbar d-flex flex-wrap align-items-center justify-content-between gap-3">
          <!-- Type Selector Tabs -->
          <div class="browse-type-tabs">
            <a href="/<%= searchQuery ? '?q=' + encodeURIComponent(searchQuery) : '' %>" class="type-tab-btn active">
              <i class="bi bi-film me-1"></i> Movies
            </a>
            <a href="/series<%= searchQuery ? '?q=' + encodeURIComponent(searchQuery) : '' %>" class="type-tab-btn">
              <i class="bi bi-tv me-1"></i> Series
            </a>
          </div>

          <!-- Filter Controls Group -->
          <div class="filter-controls-group">
            <!-- Desktop Quick Dropdowns -->
            <div class="d-none d-md-flex align-items-center gap-2">
              <!-- Genre Dropdown -->
              <div class="dropdown custom-filter-dropdown">
                <button class="btn filter-pill-btn dropdown-toggle <%= selectedGenre ? 'filter-pill-active' : '' %>" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Filter by Genre">
                  <i class="bi bi-tags"></i>
                  <span><%= activeGenreLabel || 'Genre' %></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark filter-dropdown-menu scrollable-dropdown">
                  <li><a class="dropdown-item <%= !selectedGenre ? 'active' : '' %>" href="javascript:void(0)" onclick="updateFilter('genre', '')">All Genres</a></li>
                  <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
                  <% for (const [gId, gName] of Object.entries(genreMap)) { %>
                    <li>
                      <a class="dropdown-item <%= selectedGenre === gId ? 'active' : '' %>" href="javascript:void(0)" onclick="updateFilter('genre', '<%= gId %>')">
                        <%= gName %>
                      </a>
                    </li>
                  <% } %>
                </ul>
              </div>

              <!-- Year Dropdown -->
              <div class="dropdown custom-filter-dropdown">
                <button class="btn filter-pill-btn dropdown-toggle <%= selectedYear ? 'filter-pill-active' : '' %>" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Filter by Year">
                  <i class="bi bi-calendar3"></i>
                  <span><%= selectedYear || 'Year' %></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark filter-dropdown-menu scrollable-dropdown">
                  <li><a class="dropdown-item <%= !selectedYear ? 'active' : '' %>" href="javascript:void(0)" onclick="updateFilter('year', '')">All Years</a></li>
                  <li><hr class="dropdown-divider border-secondary border-opacity-25"></li>
                  <% const currentYear = new Date().getFullYear(); %>
                  <% for (let y = currentYear; y >= 2000; y--) { %>
                    <li>
                      <a class="dropdown-item <%= selectedYear === String(y) ? 'active' : '' %>" href="javascript:void(0)" onclick="updateFilter('year', '<%= y %>')">
                        <%= y %>
                      </a>
                    </li>
                  <% } %>
                </ul>
              </div>

              <!-- Sort Dropdown -->
              <div class="dropdown custom-filter-dropdown">
                <button class="btn filter-pill-btn dropdown-toggle <%= (selectedSort && selectedSort !== 'popularity.desc') ? 'filter-pill-active' : '' %>" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Sort Results">
                  <i class="bi bi-arrow-down-up"></i>
                  <span><%= activeSortLabel || 'Sort' %></span>
                </button>
                <ul class="dropdown-menu dropdown-menu-dark filter-dropdown-menu">
                  <li>
                    <a class="dropdown-item <%= (!selectedSort || selectedSort === 'popularity.desc') ? 'active' : '' %>" href="javascript:void(0)" onclick="updateFilter('sort', 'popularity.desc')">
                      Most Popular
                    </a>
                  </li>
                  <li>
                    <a class="dropdown-item <%= selectedSort === 'vote_average.desc' ? 'active' : '' %>" href="javascript:void(0)" onclick="updateFilter('sort', 'vote_average.desc')">
                      Highest Rated
                    </a>
                  </li>
                  <li>
                    <a class="dropdown-item <%= selectedSort === 'release_date.desc' ? 'active' : '' %>" href="javascript:void(0)" onclick="updateFilter('sort', 'release_date.desc')">
                      Latest Release
                    </a>
                  </li>
                </ul>
              </div>
            </div>

            <!-- Detailed Filters Toggle Button (Desktop & Mobile) -->
            <button class="btn filter-pill-btn filter-toggle-main-btn <%= activeFilterCount > 0 ? 'filter-pill-active' : '' %>" type="button" data-bs-toggle="collapse" data-bs-target="#filter-panel-collapse" aria-expanded="<%= (selectedGenre || selectedYear || searchQuery || showFilters) ? 'true' : 'false' %>" title="Toggle detailed filter drawer">
              <i class="bi bi-sliders"></i>
              <span>Filters</span>
              <% if (activeFilterCount > 0) { %>
                <span class="active-filter-count-badge"><%= activeFilterCount %></span>
              <% } %>
            </button>

            <!-- Reset Button -->
            <% if (activeFilterCount > 0 || searchQuery) { %>
              <button class="btn btn-link text-muted filter-chip-clear-all p-1 text-decoration-none" type="button" onclick="resetFilters()" title="Reset all filters">
                <i class="bi bi-arrow-counterclockwise"></i> Reset
              </button>
            <% } %>
          </div>
        </div>

        <!-- Active Filter Chips (Genre, Year, Sort) -->
        <% if (activeFilterCount > 0) { %>
          <div class="active-filter-chips">
            <span class="text-muted small me-1"><i class="bi bi-funnel-fill text-warning me-1"></i>Active:</span>

            <% if (selectedGenre && activeGenreLabel) { %>
              <span class="filter-chip">
                <span><%= activeGenreLabel %></span>
                <button type="button" class="filter-chip-remove" onclick="removeFilter('genre')" aria-label="Remove genre filter">
                  <i class="bi bi-x"></i>
                </button>
              </span>
            <% } %>

            <% if (selectedYear) { %>
              <span class="filter-chip">
                <span><%= selectedYear %></span>
                <button type="button" class="filter-chip-remove" onclick="removeFilter('year')" aria-label="Remove year filter">
                  <i class="bi bi-x"></i>
                </button>
              </span>
            <% } %>

            <% if (selectedSort && selectedSort !== 'popularity.desc') { %>
              <span class="filter-chip">
                <span><%= activeSortLabel %></span>
                <button type="button" class="filter-chip-remove" onclick="removeFilter('sort')" aria-label="Remove sort filter">
                  <i class="bi bi-x"></i>
                </button>
              </span>
            <% } %>

            <button type="button" class="btn btn-link filter-chip-clear-all p-0 ms-2" onclick="resetFilters()">
              Clear all
            </button>
          </div>
        <% } %>
      </div>

      <!-- Compact Collapsible Filter Drawer -->
      <div class="collapse <%= showFilters ? 'show' : '' %>" id="filter-panel-collapse">
        <div class="compact-filter-drawer mb-4 p-4">
          <div class="d-flex align-items-center justify-content-between mb-3 pb-2 border-bottom border-secondary border-opacity-25">
            <div class="d-flex align-items-center gap-2">
              <i class="bi bi-sliders text-warning"></i>
              <span class="fw-bold text-white fs-6">Filter Options</span>
              <% if (activeFilterCount > 0) { %>
                <span class="badge bg-warning text-dark rounded-pill" style="font-size: 0.68rem;"><%= activeFilterCount %> active</span>
              <% } %>
            </div>
            <button type="button" class="btn-close btn-close-white small" data-bs-toggle="collapse" data-bs-target="#filter-panel-collapse" aria-label="Close filter panel"></button>
          </div>

          <form action="/" method="GET" class="row g-3 align-items-end" id="filterDrawerForm">
            <% if (searchQuery) { %>
              <input type="hidden" name="q" value="<%= searchQuery %>">
            <% } %>

            <div class="col-12 col-sm-6 col-md-4">
              <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.06em;">Genre</label>
              <select name="genre" class="form-select custom-drawer-select">
                <option value="">All Genres</option>
                <% for (const [gId, gName] of Object.entries(genreMap)) { %>
                  <option value="<%= gId %>" <%= selectedGenre === gId ? 'selected' : '' %>><%= gName %></option>
                <% } %>
              </select>
            </div>

            <div class="col-6 col-sm-6 col-md-3">
              <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.06em;">Release Year</label>
              <select name="year" class="form-select custom-drawer-select">
                <option value="">All Years</option>
                <% const curYear = new Date().getFullYear(); %>
                <% for (let y = curYear; y >= 2000; y--) { %>
                  <option value="<%= y %>" <%= selectedYear === String(y) ? 'selected' : '' %>><%= y %></option>
                <% } %>
              </select>
            </div>

            <div class="col-6 col-sm-6 col-md-3">
              <label class="form-label text-muted small fw-bold text-uppercase" style="font-size: 0.72rem; letter-spacing: 0.06em;">Sort By</label>
              <select name="sort" class="form-select custom-drawer-select">
                <option value="popularity.desc" <%= (!selectedSort || selectedSort === 'popularity.desc') ? 'selected' : '' %>>Most Popular</option>
                <option value="vote_average.desc" <%= selectedSort === 'vote_average.desc' ? 'selected' : '' %>>Highest Rated</option>
                <option value="release_date.desc" <%= selectedSort === 'release_date.desc' ? 'selected' : '' %>>Latest Release</option>
              </select>
            </div>

            <div class="col-12 col-sm-6 col-md-2 d-flex gap-2">
              <button type="submit" class="btn btn-warning w-100 fw-bold py-2">
                Apply
              </button>
              <% if (activeFilterCount > 0) { %>
                <button type="button" class="btn btn-outline-secondary py-2" onclick="resetFilters()" title="Reset Filters">
                  <i class="bi bi-arrow-counterclockwise"></i>
                </button>
              <% } %>
            </div>
          </form>
        </div>
      </div>


      <% if (allMovies.length === 0) { %>
        <div class="empty-state">
          <i class="bi bi-film fs-1 text-warning"></i>
          <h2 class="h4 mt-3">No movies found</h2>
          <p class="text-muted mb-3">Try another search.</p>
        </div>
      <% } %>
      <section class="movie-grid" aria-label="Movies">
        <% for (let movie of allMovies) { %>
          <article class="movie-card">
            <div class="poster-frame">
              <% if (movie.poster_path) { %>
                <img
                  src="https://image.tmdb.org/t/p/w342<%= movie.poster_path %>"
                  class="movie-img"
                  alt="<%= movie.title %> poster"
                  loading="lazy"
                  decoding="async"
                >
              <% } else { %>
                <div class="poster-placeholder">
                  <i class="bi bi-film"></i>
                </div>
              <% } %>
            </div>
            <div class="movie-card-body">
              <div class="d-flex justify-content-between align-items-start gap-3">
                <div>
                  <h2 class="movie-title">
                    <%= movie.title %>
                  </h2>
                  <div class="movie-meta">
                    <%= movie.release_date ? movie.release_date.split('-')[0] : 'N/A' %>
                  </div>
                </div>
                <span class="rating-pill">
                  <i class="bi bi-star-fill"></i>
                  <%= movie.avgRating ? movie.avgRating.toFixed(1) : '0.0' %>
                </span>
              </div>
              <a href="/movie/<%= movie.id %>" class="btn btn-primary mt-auto">
                <i class="bi bi-eye me-1"></i> View Details
              </a>
            </div>
          </article>
        <% } %>
      </section>
    </div>
  </main>
  <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/js/bootstrap.min.js"></script>
  <script>
    function updateFilter(key, value) {
      const url = new URL(window.location.href);
      if (value) {
        url.searchParams.set(key, value);
      } else {
        url.searchParams.delete(key);
      }
      window.location.href = url.toString();
    }

    function removeFilter(key) {
      const url = new URL(window.location.href);
      url.searchParams.delete(key);
      window.location.href = url.toString();
    }

    function resetFilters() {
      const url = new URL(window.location.href);
      url.searchParams.delete('genre');
      url.searchParams.delete('year');
      url.searchParams.delete('sort');
      url.searchParams.delete('showFilters');
      window.location.href = url.toString();
    }

    document.addEventListener('DOMContentLoaded', () => {
      const filterCollapse = document.getElementById('filter-panel-collapse');
      if (filterCollapse) {
        filterCollapse.addEventListener('shown.bs.collapse', () => {
          filterCollapse.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        });

        const navBtn = document.getElementById('navFilterToggleBtn');
        if (navBtn) {
          navBtn.addEventListener('click', () => {
            setTimeout(() => {
              if (filterCollapse.classList.contains('show')) {
                filterCollapse.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
              }
            }, 50);
          });
        }

        const urlParams = new URLSearchParams(window.location.search);
        if (urlParams.get('showFilters') === 'true') {
          setTimeout(() => {
            filterCollapse.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
          }, 200);
        }
      }
    });
  </script>
</body>
</html>
